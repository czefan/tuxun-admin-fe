{
  "name": "tuxun-admin-fe",
  "version": "2.2.0",
  "private": true,
  "description": "Tuxun admin frontend based on SoybeanAdmin, Vue3, Vite8, TypeScript, Naive UI and UnoCSS.",
  "keywords": [
    "TypeScript",
    "UnoCSS",
    "Vite8",
    "Vue3 admin ",
    "ant-design-vue v4",
    "naive-ui",
    "naive-ui-admin",
    "vue-admin-template"
  ],
  "homepage": "",
  "bugs": {},
  "license": "MIT",
  "author": "Tuxun Team",
  "repository": {
    "url": ""
  },
  "type": "module",
  "scripts": {
    "audit:deps": "pnpm audit --registry=https://registry.npmjs.org",
    "build": "vite build --mode prod",
    "build:test": "vite build --mode test",
    "check": "pnpm check:contract && pnpm lint && pnpm typecheck && pnpm test",
    "check:contract": "node ./contract/check-contract.js",
    "cleanup": "sa cleanup",
    "commit": "sa git-commit",
    "commit:zh": "sa git-commit -l=zh-cn",
    "dev": "vite --mode test",
    "dev:mock": "vite --mode mock",
    "dev:prod": "vite --mode prod",
    "fmt": "oxfmt",
    "gen-route": "sa gen-route",
    "gen:api-types": "openapi-typescript contract/apifox-import.json -o src/service/contract/schema.d.ts && oxfmt src/service/contract/schema.d.ts",
    "lint": "oxlint && eslint .",
    "lint:fix": "oxlint --fix && eslint --fix .",
    "prepare": "simple-git-hooks",
    "preview": "vite preview --mode prod",
    "release": "sa release",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "update-pkg": "sa update-pkg"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "@better-scroll/core": "2.5.1",
    "@iconify/vue": "5.0.1",
    "@sa/axios": "workspace:*",
    "@sa/color": "workspace:*",
    "@sa/hooks": "workspace:*",
    "@sa/materials": "workspace:*",
    "@sa/utils": "workspace:*",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/vue-3": "^3.31.3",
    "@vueuse/core": "14.3.0",
    "clipboard": "2.0.11",
    "compressorjs": "^1.3.0",
    "dayjs": "1.11.20",
    "defu": "6.1.7",
    "dompurify": "^3.4.13",
    "echarts": "6.1.0",
    "naive-ui": "2.44.1",
    "nprogress": "0.2.0",
    "pinia": "3.0.4",
    "qr-scanner": "^1.4.2",
    "tailwind-merge": "3.6.0",
    "vue": "3.5.34",
    "vue-draggable-plus": "0.6.1",
    "vue-i18n": "11.4.2",
    "vue-router": "5.0.7"
  },
  "devDependencies": {
    "@amap/amap-jsapi-types": "^0.0.15",
    "@elegant-router/vue": "0.3.8",
    "@iconify/json": "2.2.472",
    "@playwright/test": "1.63.0",
    "@sa/scripts": "workspace:*",
    "@sa/uno-preset": "workspace:*",
    "@soybeanjs/eslint-config-vue": "^0.0.2",
    "@types/node": "25.7.0",
    "@types/nprogress": "0.2.3",
    "@vitejs/plugin-vue": "6.0.6",
    "@vitejs/plugin-vue-jsx": "5.1.5",
    "@vue/test-utils": "^2.4.6",
    "consola": "3.4.2",
    "eslint": "10.3.0",
    "jsdom": "30.1.1",
    "kolorist": "1.8.0",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0",
    "sass": "1.99.0",
    "simple-git-hooks": "2.13.1",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "unocss": "^66.6.8",
    "unplugin-icons": "23.0.1",
    "unplugin-vue-components": "32.0.0",
    "vite": "8.0.16",
    "vite-plugin-progress": "0.0.7",
    "vite-plugin-vue-devtools": "8.2.1",
    "vite-plugin-vue-transition-root-validator": "^0.1.0",
    "vitest": "5.0.2",
    "vue-tsc": "3.2.8"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm sa git-commit-verify",
    "pre-commit": "pnpm check"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0",
    "pnpm": ">=12.6.0 <13"
  },
  "packageManager": "pnpm@12.6.0",
  "msw": {
    "workerDirectory": [
      "src/mocks/public"
    ]
  },
  "website": ""
}
