# 部署在同一域名的 /admin/ 子路径下；影响 Vite 静态资源 base、Vue Router base、OAuth callback URL。
VITE_BASE_URL=/admin/

# backend service base url, prod environment
# 与后台同域部署，浏览器同源请求，Cookie 正常携带
VITE_SERVICE_BASE_URL=/api

# ⚠️ 必须在这里显式声明高德配置，不能留空不写。
# Vite 的 .env.local 不带 mode 后缀，「所有」模式都会加载它（包括 prod），
# 优先级 .env < .env.local < .env.prod，所以只有在本文件里显式赋值，
# 才能保证生产构建不会把开发机 .env.local 里的密钥打进产物。

# key 本身是公开信息（一定会出现在前端产物里），靠高德控制台的域名白名单防盗用。
# 填入生产域名对应的 Web 端 (JS API) key；留空则地图降级为手填经纬度。
VITE_AMAP_KEY=b42518a6c7e9f0600567f26b6fba48ff
# 生产环境严禁内联 jscode —— 必须保持为空，改由下面的代理转发。
VITE_AMAP_SECURITY_JSCODE=
# 后端代理地址，由后端转发 restapi.amap.com 并在服务端附加 jscode。
VITE_AMAP_SERVICE_HOST=/_AMapService

# ⚠️ OAuth 授权服务配置同样必须在这里显式声明，不能留空不写。
# .env.local 不带 mode 后缀，「所有」模式都会加载它（包括 prod），
# 优先级 .env < .env.local < .env.prod，所以只有在本文件里显式赋值，
# 才能保证生产构建不会把开发机 .env.local 里改过的授权地址打进产物。
# client_id 是公开值（一定会出现在 authorize URL 里），不含任何 secret。
VITE_OAUTH_BASE_URL=https://oauth.tiaozhan.com
VITE_OAUTH_CLIENT_ID=tu_xun

# ⚠️ VITE_SERVICE_PROXY_TARGET 只在 .env.test / .env.local 里定义，是纯 dev 代理配置。
# .env.local 不带 mode 后缀会加载进 prod，这里显式置空，防止开发机地址（如 localhost:8088）
# 被 Vite 的 import.meta.env 聚合对象打进生产产物。
VITE_SERVICE_PROXY_TARGET=
