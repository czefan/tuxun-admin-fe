# backend service base url, test environment
VITE_SERVICE_BASE_URL=/api

# Vite proxies /api to the local Go service while keeping cookies same-origin in the browser.
VITE_SERVICE_PROXY_TARGET=http://localhost:8088

# tz-oauth 授权服务（学校统一认证）；client_id 继承 .env 的 tu_xun
# 本地联调时不要把这个地址改成 http://localhost:8088 —— 8088 已被上面的 Go 后端占用（见 SERVICE_INTEGRATION §2）
VITE_OAUTH_BASE_URL=https://oauth.tiaozhan.com
