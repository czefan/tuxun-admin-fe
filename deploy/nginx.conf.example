# 图寻后台管理端 (tuxun-admin-fe) Nginx 部署参考配置
# SPA 模式 —— VITE_ROUTER_HISTORY_MODE=history，必须配置 try_files 回退 index.html，
# 否则除首次加载外的任意路径（含 OAuth 认证服务回跳整页加载 /admin/login/callback）都会 404，
# 登录链路会断在最后一步。

server {
    listen 80;
    server_name your-admin-domain.com;

    # 指向 Vite 构建产物目录（非 dev 的 index.html 所在目录）
    root /var/www/tuxun-admin-fe/dist;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # History 路由 fallback 关键配置。
    # 认证服务回跳是对 /admin/login/callback 的整页加载，命中此 location 回退到 index.html；
    # 若缺少 try_files，回调页整页刷新会 404，登录无法完成。
    location = /admin {
        return 308 /admin/;
    }

    # 对应 .env.prod 的 VITE_BASE_URL=/admin/；alias 指向 dist 本身。
    location /admin/ {
        alias /var/www/tuxun-admin-fe/dist/;
        try_files $uri $uri/ /admin/index.html;
    }

    # index.html 绝不能缓存：/admin/assets/ 是内容 hash + 强缓存，
    # 一旦 index.html 被缓存，用户会一直加载旧版本的 assets 引用
    location = /admin/index.html {
        alias /var/www/tuxun-admin-fe/dist/index.html;
        add_header Cache-Control "no-cache, must-revalidate";
    }

    # 静态资源强缓存
    location /admin/assets/ {
        alias /var/www/tuxun-admin-fe/dist/assets/;
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # API 反向代理（同域部署 /api → 图寻 Go 后端；如需跨域，请后端配置 CORS + 凭据）
    # location /api/ {
    #     proxy_pass http://127.0.0.1:8088/api/;
    #     proxy_set_header Host $host;
    #     proxy_set_header X-Real-IP $remote_addr;
    #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    #     proxy_set_header X-Forwarded-Proto $scheme;
    # }

    # 高德地图安全服务代理（配合前端 VITE_AMAP_SERVICE_HOST=/_AMapService）
    # ⚠️ 注意事项：
    # 1. 前端请求时已经自带了 key 参数，Nginx 转发里【千万不要】再加 key，否则会导致参数重复或鉴权失败！
    # 2. 这里只需要在后端自动附加安全密钥 jscode（若使用代理方式隐藏密钥）：
    # location /_AMapService/ {
    #     set $args "$args&jscode=你的高德安全密钥_SECURITY_JSCODE";
    #     proxy_pass https://restapi.amap.com/;
    #     proxy_set_header Host restapi.amap.com;
    #     proxy_ssl_server_name on;
    # }
}
